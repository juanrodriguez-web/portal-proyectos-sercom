# Supabase (proyecto dedicado a Gestor de Proyectos SERCOM - Vodafone,
# NO reutilizar el de Portal RRHH: dominios de datos distintos)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo server-side (Server Actions / Route Handlers). Nunca exponer al cliente.
SUPABASE_SERVICE_ROLE_KEY=

# Google Workspace - Shared Drive (spec seccion 18)
# Service account con acceso al Shared Drive del proyecto. Se usa
# exclusivamente en backend (server actions / route handlers).
GOOGLE_DRIVE_CLIENT_EMAIL=
GOOGLE_DRIVE_PRIVATE_KEY=
GOOGLE_DRIVE_SHARED_DRIVE_ID=
# Carpeta raiz "/PROJECTS" dentro del Shared Drive (spec 18.2)
GOOGLE_DRIVE_PROJECTS_ROOT_FOLDER_ID=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
